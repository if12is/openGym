# Dependencies and build output — 240 MB of frontend/node_modules and
# frontend/dist were sitting untracked with nothing to stop `git add -A`
# picking them up.
node_modules/
frontend/dist/
web/dist/
website/dist/

# Android build artefacts
frontend/android/build/
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/gradle-build.log
# Generated by CI (and never the same twice) — see .github/workflows/android-apk.yml
frontend/android/app/*.keystore
frontend/android/app/google-services.json

# iOS
frontend/ios/App/Pods/
frontend/ios/App/build/
frontend/ios/App/App/public/

# Local env and editor noise
.env
.env.local
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/

# Runtime data for the self-hosted API.
# NOTE: data/db.json, data/secret and data/vapid.json are already tracked, so
# they are deliberately not listed here — an ignore rule would not untrack them,
# it would only hide the fact that they are in the repo.
api/data/
